# 請在 VPS 的 /etc/echo-gallery/backend.env 建立實際設定，不要將真實值提交至 Git。

JDBC_DATABASE_URL=jdbc:postgresql://db-host.example.com:5432/postgres?sslmode=require
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password
JWT_SECRET=replace_with_at_least_32_random_bytes
FRONTEND_URL=https://gallery.example.com
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1

# 2 GB VPS 的保守起始值；依實際 RAM、監控結果與同機服務再調整。
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -Duser.timezone=Asia/Taipei
